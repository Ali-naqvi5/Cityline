{
	# Let's Encrypt contact; certificates are issued and renewed automatically.
	email admin@citylineairporttransfers.com
	servers {
		trusted_proxies static private_ranges
	}
}

# SEO-06: one official address, without www.
citylineairporttransfers.com {
	encode zstd gzip
	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}

www.citylineairporttransfers.com {
	redir https://citylineairporttransfers.com{uri} permanent
}
