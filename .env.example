# Cityline — environment variables (§16).
# Copy to .env.local for development. Production values live in
# /srv/cityline/.env.production on the VPS and are NEVER committed.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_SECRET=change-me-32-chars-minimum-random
# Launch gate (PRD-02): "on" shows the coming-soon page to the public.
LAUNCH_GATE=off
PREVIEW_TOKEN=change-me-random
CRON_SECRET=change-me-random
APP_TAG=local

# --- Database ---
DATABASE_URL=postgres://cityline:cityline@localhost:5432/cityline
POSTGRES_USER=cityline
POSTGRES_PASSWORD=cityline
POSTGRES_DB=cityline

# --- Storage (DATA-02) ---
STORAGE_PATH=./storage

# --- Stripe (test keys until launch, PRD-04) ---
# Prefer a restricted key (rk_...) over the secret key (sk_...) in production:
# Checkout Sessions write, PaymentIntents read. Never commit a real key.
STRIPE_SECRET_KEY=
# Baked into the browser bundle at build time — rebuild after changing it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Locally: printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# Production: the signing secret of the Dashboard endpoint for
# https://citylineairporttransfers.com/api/webhooks/stripe (see docs/runbook-vps.md).
STRIPE_WEBHOOK_SECRET=

# --- Google Maps (browser key restricted by domain, server key by VPS IP) ---
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Email / SMS ---
RESEND_API_KEY=
MAIL_FROM=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Spam protection ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Monitoring ---
SENTRY_DSN=
NEXT_PUBLIC_GA4_ID=

# --- Backups (used by the backup container, not the app) ---
BACKUP_ARCHIVE_PASSWORD=
HIDRIVE_WEBDAV_URL=
HIDRIVE_USER=
HIDRIVE_PASSWORD=
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
