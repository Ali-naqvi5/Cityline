# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Cityline ---
# secrets: .env.production lives on the VPS only, never in git (NFR-04)
.env
.env.*
!.env.example
# local uploads / private documents (DATA-02) — these live in a Docker volume
/storage
# test output
/playwright-report
/test-results
/coverage

# worker bundle — built by `pnpm build:worker`, and rebuilt inside the Docker
# image. Committing it would mean a stale copy shadowing the real source.
/dist

# design/ is deliberately NOT ignored. It is the source of truth for how the
# site looks (§6), and docs/design-deviations.md can only be audited against
# it. ~37MB of one-off Stitch exports that never churn is a fair price for
# that; it is excluded from the Docker build context instead (.dockerignore).
